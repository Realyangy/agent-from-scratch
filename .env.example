# 示例配置：复制为 .env 再修改；不要将真实密钥提交到 GitHub
# 可选：Qwen3.5-27b-AWQ-4bit 或 DeepSeekV4.1-Flash
AGENT_MODEL_NAME=Qwen3.5-27b-AWQ-4bit
AGENT_API_TIMEOUT=120
AGENT_API_MAX_RETRIES=2

# Qwen：vLLM 在另一环境运行，此处只需要它的 HTTP 地址和模型 ID
AGENT_VLLM_BASE_URL=http://127.0.0.1:8001/v1
AGENT_VLLM_MODEL=
AGENT_VLLM_API_KEY=EMPTY

# DeepSeek：沿用 KGQA 仓库的调用配置
# 请确认该 API 端点实际支持 AGENT_DEEPSEEK_MODEL 所指定的模型
AGENT_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
AGENT_DEEPSEEK_MODEL=deepseek-flash
LYY_DEEPSEEK_API_KEY=
